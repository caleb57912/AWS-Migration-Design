lLoop=1;html=1;strokeWidth=2;strokeColor=#3F8624;fontColor=#3F8624;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="hvpn" target="htgw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=1;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="htgw" target="hdr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1685" y="732"/></Array></mxGeometry></mxCell><mxCell id="edge11" value="allow-list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="egnat" target="inet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ddi" value="&lt;b&gt;&lt;font color=&quot;#DD344C&quot;&gt;Defense in depth: a phished clinic workstation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;An attacker on a clinic PC must still get past:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Network Firewall&lt;/b&gt; inspects clinic → AWS traffic on the Transit Gateway&lt;br&gt;&lt;b&gt;2 · NACL&lt;/b&gt; at the data-tier boundary allows only app + integration subnets&lt;br&gt;&lt;b&gt;3 · Security groups&lt;/b&gt; reference tiers: only app + integration SGs reach Aurora :5432&lt;br&gt;&lt;b&gt;4 · Encryption&lt;/b&gt; with KMS keys the attacker&#x27;s identity cannot use (ABAC on DataClass=restricted)&lt;br&gt;&lt;br&gt;Meanwhile: GuardDuty + MDR detect, EventBridge quarantines the instance, CloudTrail data events prove what was touched.&lt;br&gt;&lt;br&gt;&lt;b&gt;Egress:&lt;/b&gt; even with a foothold, outbound traffic only reaches allow-listed domains, so PHI can&#x27;t be sent to an attacker&#x27;s server.&lt;br&gt;&lt;br&gt;&lt;b&gt;Blast radius:&lt;/b&gt; each account is a hard boundary. A compromised Dev account can&#x27;t reach Prod: separate IAM, SCPs, and TGW route tables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F2A900;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#232F3E;arcSize=6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="560" height="490" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 - DR (us-east-1)" id="p3"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Disaster recovery · pilot light in us-east-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1880" height="1000" as="geometry"/></mxCell><mxCell id="w2" value="us-west-2 (Oregon) · primary · always running" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;co